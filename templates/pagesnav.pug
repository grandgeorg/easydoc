details.pagesnav-details
  summary.nav-title.text-center #{t.pages}
  if pages && pages.length
    ul
      each item in pages
        li
          if item.file === file
            a(href=item.file class="active")
              div.page-title #{item.title}
              div.page-filename #{item.file}
          else
            a(href=item.file)
              div.page-title #{item.title}
              div.page-filename #{item.file}
