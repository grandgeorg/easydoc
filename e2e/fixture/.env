# EasyDoc e2e fixture configuration. Committed and deterministic; no secrets.
# Specs in e2e/*.spec.js rely on these values.
EASYDOC_LANG_FALLBACK=en
EASYDOC_TITLE_FALLBACK=Fixture

EASYDOC_BRAND_URL=https://example.com
EASYDOC_BRAND_NAME=Fixture
EASYDOC_BRAND_SECONDARY=Site

EASYDOC_TOC_INCLUDELEVEL=[1,2,3]

EASYDOC_DISABLE_TAG_NAVIGATOR=true
EASYDOC_DISABLE_THEME_OVERRIDES=true
EASYDOC_NAVBAR_SEARCH=true
EASYDOC_ENABLE_FULLTEXT_SEARCH=false
EASYDOC_GENERATE_AUTO_INDEX=false
